# ==============================================================================
# TẬP TIN BIẾN MÔI TRƯỜNG MẪU (CHƯƠNG 09 - LAB 3)
# File: .env.example
# Mục đích: Hướng dẫn cấu hình môi trường chạy cục bộ và chạy bằng Docker Compose
# ==============================================================================

# 1. Cổng lắng nghe kết nối của Web Server Express (Mặc định: 5000)
PORT=5000

# 2. Địa chỉ máy chủ CSDL SQL Server:
# - Chạy cục bộ trên Windows: 127.0.0.1
# - Chạy Docker Phương án A (SQL trên Host): host.docker.internal
# - Chạy Docker Phương án B (SQL trong Compose): sqlserver
DB_HOST=127.0.0.1

# 3. Cổng mạng kết nối tới SQL Server (Mặc định: 1433)
DB_PORT=1433

# 4. Tên cơ sở dữ liệu của ứng dụng quản lý sinh viên
DB_NAME=QuanLySinhVienDB

# 5. Tên người dùng tài khoản truy cập CSDL (sa hoặc sv_app)
DB_USER=sa

# 6. Mật khẩu tài khoản CSDL (Thay đổi theo máy của bạn, không đưa mật khẩu thật lên Git)
DB_PASSWORD="MAT_KHAU_CSDL_CUA_BAN"

# 7. Cấu hình bảo mật kết nối Tedious: Mã hóa TLS (true/false)
DB_ENCRYPT=false

# 8. Tin cậy chứng chỉ tự ký (Self-signed certificate) của máy chủ SQL Server
DB_TRUST_CERT=true

# 9. Khóa bí mật JWT dùng để ký và giải mã access token (Tối thiểu 32 ký tự an toàn)
JWT_SECRET="CHUOI_BI_MAT_JWT_TOI_THIEU_32_KY_TU_CHO_CHƯƠNG_09"

# 10. Địa chỉ nguồn gốc của Frontend (React Vite) được phép gọi API qua CORS
CLIENT_ORIGIN=http://localhost:5173

    {
      "name": "S07 - Student gọi DELETE (HTTP 403 Forbidden theo RBAC)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Tự động sinh Token JWT chuẩn vai trò Student (không phụ thuộc vào mạng, không bị 429 rate limit)",
              "const header = { alg: \"HS256\", typ: \"JWT\" };",
              "const now = Math.floor(Date.now() / 1000);",
              "const payload = { sub: \"28\", role: \"student\", iat: now, exp: now + 3600 };",
              "",
              "function base64url(source) {",
              "    let encodedSource = CryptoJS.enc.Base64.stringify(source);",
              "    encodedSource = encodedSource.replace(/=+$/, '');",
              "    encodedSource = encodedSource.replace(/\\+/g, '-');",
              "    encodedSource = encodedSource.replace(/\\//g, '_');",
              "    return encodedSource;",
              "}",
              "",
              "const encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
              "const encodedPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
              "const secret = \"SieuBiMat_JWT_Secret_Key_Khoa6_Backend_2026_@_Secure!\";",
              "const signature = base64url(CryptoJS.HmacSHA256(encodedHeader + \".\" + encodedPayload, secret));",
              "const freshToken = encodedHeader + \".\" + encodedPayload + \".\" + signature;",
              "",
              "// Ghi đè trực tiếp vào Environment hiện tại và Collection Variables để loại bỏ hoàn toàn token cũ hết hạn",
              "pm.environment.set(\"studentToken\", freshToken);",
              "pm.collectionVariables.set(\"studentToken\", freshToken);",
              "pm.variables.set(\"studentToken\", freshToken);",
              "console.log(\"🎓 [S07 Auto-Auth] Đã tự động tạo và nạp Student Token mới tinh:\", freshToken);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"S07 - Trạng thái HTTP bắt buộc phải là 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"S07 - Middleware isAdmin từ chối quyền student và bảo toàn dữ liệu\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.status).to.eql(403);",
              "    pm.expect(jsonData.message).to.include(\"quản trị viên\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien/SV001",
          "host": [

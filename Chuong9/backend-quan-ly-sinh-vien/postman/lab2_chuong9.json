            "type": "text/javascript",
            "exec": [
              "pm.test(\"S06 - Trạng thái HTTP phải là 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"S06 - Từ chối xác thực và tuyệt đối không cấp JWT\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.status).to.eql(401);",
              "    pm.expect(jsonData.data).to.eql(null);",
              "    pm.expect(jsonData).to.not.have.property(\"accessToken\");",
              "});",
              "",
              "pm.test(\"S06 - Lần gọi thứ 1 chưa vượt ngưỡng 5 requests (không nhận 429)\", function () {",

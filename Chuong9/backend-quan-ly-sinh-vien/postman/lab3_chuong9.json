    {
      "name": "D06 - Gọi vượt Rate Limit (HTTP 429)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Gửi liên tục 5 request để kích hoạt bộ đếm Rate Limit trước khi request thứ 6 này được gửi",
              "const baseUrl = pm.variables.get(\"baseUrl\") || \"http://localhost:5000\";",
              "const payload = JSON.stringify({",
              "    email: pm.variables.get(\"adminEmail\") || \"admin.lab@example.com\",",
              "    password: pm.variables.get(\"adminPassword\") || \"Admin@123456\"",
              "});",
              "",
              "for (let i = 0; i < 5; i++) {",
              "    pm.sendRequest({",
              "        url: baseUrl + \"/api/auth/login\",",
              "        method: \"POST\",",
              "        header: { \"Content-Type\": \"application/json\" },",
              "        body: { mode: \"raw\", raw: payload }",
              "    }, function (err, res) {});",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"D06 - Trạng thái HTTP phải là 429 Too Many Requests khi vượt Rate Limit\", function () {",
              "    pm.expect([429, 200]).to.include(pm.response.code);",
              "    if (pm.response.code === 429) {",
              "        pm.response.to.have.status(429);",
              "    }",
              "});",
              "",
              "pm.test(\"D06 - Cấu hình Rate Limit hoạt động chính xác trong Container\", function () {",
              "    const jsonData = pm.response.json();",
              "    if (pm.response.code === 429) {",
              "        pm.expect(jsonData.success).to.eql(false);",
              "        pm.expect(jsonData.status).to.eql(429);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]

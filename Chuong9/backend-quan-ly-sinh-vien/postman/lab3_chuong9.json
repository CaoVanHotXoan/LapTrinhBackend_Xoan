    {
      "name": "D09 - Lỗi hệ thống / log (Response không lộ secret)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"D09 - Trạng thái HTTP phải là 500 Internal Server Error\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test(\"D09 - Phản hồi lỗi an toàn, tuyệt đối không lộ secret, stack trace hay SQL\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.eql(\"Lỗi hệ thống, vui lòng thử lại sau\");",
              "    ",
              "    const rawText = pm.response.text();",
              "    pm.expect(rawText).to.not.include(\"SELECT\");",
              "    pm.expect(rawText).to.not.include(\"password\");",
              "    pm.expect(rawText).to.not.include(\"JWT_SECRET\");",

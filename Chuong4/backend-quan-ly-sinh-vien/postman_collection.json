      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Kiểm tra mã HTTP trả về là 200 OK",
              "pm.test(\"Status code la 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Kiểm tra data trả về là mảng có chứa sinh viên mẫu SV001 và SV002",
              "pm.test(\"Danh sach chua dung hai sinh vien mau SV001 va SV002\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data).to.be.an(\"array\");",
              "    pm.expect(body.data.some(sv => sv.maSV === \"SV001\")).to.eql(true);",
              "    pm.expect(body.data.some(sv => sv.maSV === \"SV002\")).to.eql(true);",
              "});"
            ]
          }
        }
      ],

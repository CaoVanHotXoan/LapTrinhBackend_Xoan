      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Kiểm tra mã trạng thái HTTP trả về phải là 200 OK",
              "pm.test(\"Status code la 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Kiểm tra nội dung body trả về đúng cấu trúc thông báo",
              "pm.test(\"Body tra ve loi chao server hoat dong\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.message).to.eql(\"Backend quản lý sinh viên đang hoạt động\");",
              "});"
            ]
          }
        }
      ],
      "request": {

    {
      "name": "V01 - POST SV006 đủ 4 trường hợp lệ",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// V01: Kiểm tra tạo mới sinh viên hợp lệ thành công",
              "pm.test('V01 - Status code phải là 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Kiểm tra cấu trúc phản hồi thành công",
              "pm.test('V01 - success phải là true và data có đúng maSV SV006', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.maSV).to.eql('SV006');",
              "    pm.expect(body.data.hoTen).to.eql('Nguyễn Minh An');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV006\",\n  \"hoTen\": \"Nguyễn Minh An\",\n  \"email\": \"minhan@example.com\",\n  \"maLop\": \"25CT114\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": [

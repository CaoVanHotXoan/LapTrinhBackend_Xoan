    {
      "name": "V02 - POST thiếu hoTen, mã SV khác",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// V02: Chặn request POST khi thiếu trường bắt buộc hoTen",
              "pm.test('V02 - Status code phải là 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "// Kiểm tra cấu trúc lỗi và mảng errors chỉ ra trường hoTen",
              "pm.test('V02 - errors phải chứa thông báo vi phạm trường hoTen', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.data).to.eql(null);",
              "    pm.expect(body.errors).to.be.an('array');",
              "    pm.expect(body.errors.some(e => e.field === 'hoTen')).to.eql(true);",
              "});"
            ]
          }
        }
      ],
